@startuml
skinparam classAttributeIconSize 0

class HappinessModel {
  - sleep: DoubleProperty
  - coffee: DoubleProperty
  - communication: DoubleProperty
  - work: DoubleProperty
  - weekends: DoubleProperty
  - happinessIndex: DoubleProperty
  - recommendation: StringProperty
  + setData(...)
  + getHappinessIndex()
  + getRecommendation()
}

class HappinessController {
  - model: HappinessModel
  - mainView: MainView
  + openInputWindow()
  + saveData()
}

class MainView {
  - enterDataButton: Button
  + bindToModel(model)
}

class InputView {
  - sleepField: TextField
  - coffeeField: TextField
  - communicationField: TextField
  - workField: TextField
  - weekendsField: TextField
  - saveButton: Button
}

HappinessController --> HappinessModel
HappinessController --> MainView
HappinessController --> InputView
MainView ..> HappinessModel : observes / binds
HappinessModel ..> MainView : active notifications

@enduml
